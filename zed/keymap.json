// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
	{
		"context": "Workspace",
		"bindings": {
			"space space": "file_finder::Toggle",
		},
	},
	{
		"context": "ProjectPanel && not_editing",
		"bindings": {
			"s h": "workspace::ActivatePaneLeft",
		},
	},
	{
		"context": "(vim_mode == helix_normal || vim_mode == helix_select) && !menu",
		"bindings": {
			"e c": "editor::Copy",
		},
	},
	{
		"context": "VimControl && !menu",
		"bindings": {
			"g s": "outline::Toggle",
			"g i": "editor::ToggleCodeActions",
			"g d": "editor::OpenExcerpts",
			"g c": ["editor::ToggleComments", { "advance_downwards": false }],
		},
	},
	{
		"context": "Editor && vim_mode == visual && !VimWaiting && !menu",
		"bindings": {
			"g c": "editor::ToggleComments",
		},
	},
	{
		"context": "ProjectPanel && not_editing",
		"bindings": {
			"s left": "workspace::ActivatePaneLeft",
		},
	},
	{
		"context": "Editor && vim_mode == normal && !VimWaiting && !menu",
		"bindings": {
			"space e": "editor::Hover",
			//Buffer
			"s v": "pane::SplitRight",
			"s s": "pane::SplitDown",
			"s right": "workspace::ActivatePaneRight",
			"s left": "workspace::ActivatePaneLeft",
			"s up": "workspace::ActivatePaneUp",
			"s down": "workspace::ActivatePaneDown",
			"space h": "pane::ActivatePreviousItem",
			"space l": "pane::ActivateNextItem",
			"space c": "pane::CloseActiveItem",
			"space space": "file_finder::Toggle",
			"space s": "pane::DeploySearch",
			"space f": "editor::Format",
			"space m": "tab_switcher::Toggle",
			"ctrl-w right": "workspace::ToggleRightDock",
			"ctrl-w left": "workspace::ToggleLeftDock",

			//Error navigation
			"] d": "editor::GoToDiagnostic",
			"[ d": "editor::GoToPreviousDiagnostic",

			//Git
			"] g": "editor::GoToHunk",
			"[ g": "editor::GoToPreviousHunk",
		},
	},
	{
		"context": "Workspace",
		"bindings": {
			"ctrl-shift-e a": "agent::ToggleFocus",
		},
	},
]
